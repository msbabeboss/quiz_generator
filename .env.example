# ============================================================
# .env.example — Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz_db
DB_USER=root
DB_PASS=

# ── Pusher (real-time live submissions) ──────────────────────
# Sign up free at https://pusher.com
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_APP_ID=your_pusher_app_id
PUSHER_CLUSTER=ap1

# ── Invite codes (change before deploying!) ──────────────────
ADMIN_INVITE_CODE=CHANGE_ME_ADMIN
TEACHER_INVITE_CODE=CHANGE_ME_TEACHER

# ── Email / SMTP (for password reset) ────────────────────────
# Gmail: enable 2FA then generate an App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=QuizGen

# ── AI Question Generation ────────────────────────────────────
# Groq (free): https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Google Gemini (optional): https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# OpenAI (optional): https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key
