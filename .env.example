# ============================================================
# .env.example — Copy this to .env and fill in your values.
#
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
#
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Standard XAMPP settings — just change DB_PASS if you set one
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quiz_db
DB_USER=root
DB_PASS=

# ── App base path ─────────────────────────────────────────────
# Standard XAMPP (http://localhost/quiz_generator/) → /quiz_generator
# Virtual host root (http://quiz.local/)            → leave blank
APP_BASE_PATH=/quiz_generator

# ── Pusher (real-time live submissions) ──────────────────────
# Free account at https://pusher.com
# Leave blank to disable live features
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_APP_ID=
PUSHER_CLUSTER=ap1

# ── Invite codes (change before deploying!) ──────────────────
ADMIN_INVITE_CODE=QUIZADMIN2025
TEACHER_INVITE_CODE=QUIZTEACHER2025

# ── Email / SMTP (for password reset emails) ─────────────────
# Gmail: enable 2FA then generate an App Password at
# https://myaccount.google.com/apppasswords
# Leave blank to disable password reset emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=QuizGen

# ── AI Question Generation ────────────────────────────────────
# Free Groq API key at https://console.groq.com
# Leave blank to disable AI quiz generation
GROQ_API_KEY=

# Optional alternatives
GEMINI_API_KEY=
OPENAI_API_KEY=
